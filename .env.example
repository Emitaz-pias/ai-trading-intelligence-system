# Local service configuration. Copy to .env for local development.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/ai_trading_intelligence
COMPOSE_MONGO_URI=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
COLLECTOR_TOKEN=replace-with-a-different-random-secret-at-least-32-characters
ANALYSIS_URL=http://localhost:8001
DATA_MODE=illustrative
MARKET_SYMBOL=XAUUSD
MAX_TICK_AGE_SECONDS=30
MARKET_DATA_RETENTION_DAYS=1825
ALERT_RETENTION_DAYS=1095
AUDIT_RETENTION_DAYS=2555
ALLOW_REGISTRATION=true
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
TRADING_ECONOMICS_API_KEY=
